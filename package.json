{
  "name": "portfolio-everton",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/check-content.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test scripts/*.test.mjs lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.488.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vinext": "1.3.0",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
