{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./app/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types",
      "vinext/types"
    ]
  },
  "include": [
    "app",
    "worker",
    "lib"
  ]
}
